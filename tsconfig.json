{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@specmark/react": ["./packages/sm-react/src/index.ts"]
    }
  },
  "include": [
    "packages/sm-react/src/**/*.ts",
    "packages/sm-react/src/**/*.tsx",
    "playground/react-antd/src/**/*.ts",
    "playground/react-antd/src/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/dist", "artifacts"]
}
