{
  "name": "@specmark/playground-react-antd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @specmark/css run build",
    "build": "vite build",
    "extract": "node scripts/extract.mjs",
    "summarize": "node scripts/summarize.mjs",
    "report": "node scripts/report.mjs",
    "conformance": "node scripts/conformance.mjs",
    "selftest": "node scripts/conformance.mjs --selftest",
    "diff": "node scripts/visual-diff.mjs",
    "conformance:vue": "node scripts/conformance.mjs --page=vue.html",
    "diff:vue": "node scripts/visual-diff.mjs --page=vue.html",
    "verify": "pnpm --filter @specmark/css run build && node scripts/check-theme-tokens.mjs && node scripts/conformance.mjs && node scripts/conformance.mjs --selftest && node scripts/visual-diff.mjs && node scripts/conformance.mjs --page=vue.html && node scripts/visual-diff.mjs --page=vue.html && node scripts/visual-diff.mjs --theme=dark && node scripts/visual-diff.mjs --page=vue.html --theme=dark",
    "extract:dark": "node scripts/extract.mjs --theme=dark",
    "diff:dark": "node scripts/visual-diff.mjs --theme=dark",
    "diff:dark:vue": "node scripts/visual-diff.mjs --page=vue.html --theme=dark"
  },
  "dependencies": {
    "antd": "5.29.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.73.0",
    "lucide-vue-next": "^1.0.0",
    "playwright-core": "^1.65.1",
    "vite": "^6.0.5"
  }
}
