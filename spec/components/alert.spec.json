{
  "$schema": "../protocol.schema.json",
  "component": "Alert",
  "protocol": 1,
  "status": "draft",
  "summary": "警告提示。一条带语义色彩的横幅，可关闭。",
  "anatomy": {
    "root": {
      "class": "sm-alert",
      "tag": "div",
      "required": true,
      "data": {
        "type": {
          "kind": "variant",
          "enum": ["success", "info", "warning", "error"],
          "required": true,
          "default": "info"
        }
      },
      "attrs": { "role": { "required": true, "default": "alert" } }
    },
    "parts": {
      "message": {
        "class": "sm-alert__message",
        "tag": "div",
        "required": true,
        "order": 1
      },
      "description": {
        "class": "sm-alert__description",
        "tag": "div",
        "required": false,
        "order": 2,
        "condition": "传入 description"
      },
      "close": {
        "class": "sm-alert__close",
        "tag": "button",
        "required": false,
        "order": 3,
        "condition": "closable",
        "attrs": { "type": { "required": true, "default": "button" } },
        "aria": { "aria-label": "必填" }
      }
    }
  },
  "invariants": [
    "root 必须带 role=\"alert\"。",
    "message 必须存在且只出现一次。",
    "close 若存在必须是 button，且位于最后。",
    "语义类型只由 data-type 决定。"
  ],
  "a11y": ["role=\"alert\" 会打断读屏，仅在需要即时播报时使用。"],
  "notes": "第一个带 role=\"alert\" 的容器。"
}
