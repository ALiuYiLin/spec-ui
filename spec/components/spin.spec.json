{
  "$schema": "../protocol.schema.json",
  "component": "Spin",
  "protocol": 1,
  "status": "draft",
  "summary": "加载中。一个旋转的指示器，可带文案。",
  "anatomy": {
    "root": {
      "class": "sm-spin",
      "tag": "div",
      "required": true,
      "data": {
        "size": {
          "kind": "variant",
          "enum": [
            "sm",
            "md",
            "lg"
          ],
          "required": true,
          "default": "md"
        }
      },
      "attrs": {
        "role": {
          "required": true,
          "default": "status"
        }
      },
      "aria": {
        "aria-label": "必填，例如「加载中」"
      }
    },
    "parts": {
      "dot": {
        "class": "sm-spin__dot",
        "tag": "span",
        "required": true,
        "order": 1,
        "aria": {
          "aria-hidden": "true"
        },
        "requires": {
          "inside": "root"
        }
      },
      "tip": {
        "class": "sm-spin__tip",
        "tag": "div",
        "required": false,
        "order": 2,
        "condition": "传入 tip"
      }
    }
  },
  "invariants": [
    "root 必须带 role=\"status\" 与可访问名称。",
    "dot 必须存在且只出现一次，并带 aria-hidden。",
    "动画必须尊重 prefers-reduced-motion。"
  ],
  "a11y": [
    "role=\"status\" 会让加载状态被读屏播报；纯装饰的转圈不要用这个角色。"
  ],
  "notes": "第一个需要处理 prefers-reduced-motion 的组件。"
}
