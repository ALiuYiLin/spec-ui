{
  "$schema": "../protocol.schema.json",
  "component": "Statistic",
  "protocol": 1,
  "status": "draft",
  "summary": "统计数值。一行标题加一个大号数字。",
  "anatomy": {
    "root": {
      "class": "sm-statistic",
      "tag": "div",
      "required": true
    },
    "parts": {
      "title": {
        "class": "sm-statistic__title",
        "tag": "div",
        "required": false,
        "order": 1,
        "condition": "传入 title",
        "requires": {
          "inside": "root",
          "lane": {
            "name": "root-row",
            "order": 1
          },
          "parent": {
            "layout": "block"
          }
        }
      },
      "value": {
        "class": "sm-statistic__value",
        "tag": "div",
        "required": true,
        "order": 2,
        "requires": {
          "inside": "root",
          "lane": {
            "name": "root-row",
            "order": 2
          },
          "parent": {
            "layout": "block"
          }
        }
      }
    }
  },
  "invariants": [
    "value 必须存在且只出现一次。",
    "title 若存在必须位于 value 之前。",
    "数值格式化（千分位、小数位）由实现负责，不体现在 DOM 契约里。"
  ],
  "a11y": [
    "数值应有可读文本；纯图标指标需要 title 提供上下文。"
  ],
  "notes": "第一个「大号数值」组件。"
}
