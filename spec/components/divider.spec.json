{
  "$schema": "../protocol.schema.json",
  "component": "Divider",
  "protocol": 1,
  "status": "draft",
  "summary": "分割线。线条由伪元素绘制，DOM 里只有一个根节点（可选一个文字槽位）。",
  "anatomy": {
    "root": {
      "class": "sm-divider",
      "tag": "div",
      "required": true,
      "data": {
        "orientation": {
          "kind": "config",
          "enum": ["horizontal", "vertical"],
          "required": true,
          "default": "horizontal"
        },
        "variant": {
          "kind": "variant",
          "enum": ["solid", "dashed", "dotted"],
          "required": true,
          "default": "solid"
        }
      }
    },
    "parts": {
      "text": {
        "class": "sm-divider__text",
        "tag": "span",
        "required": false,
        "order": 1,
        "condition": "有文字内容"
      }
    }
  },
  "invariants": [
    "text 若存在，必须是 root 的直接子节点且只出现一次。",
    "线条不得作为独立 DOM 节点出现——必须用伪元素绘制。",
    "vertical 时 root 必须带 aria-orientation=\"vertical\"，horizontal 时可省略。"
  ],
  "a11y": ["分隔线是纯视觉元素，不需要 role；语义分隔应使用标题层级。"],
  "notes": "第一个“零部件”组件（无文字时）。"
}
