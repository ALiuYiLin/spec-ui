{
  "$schema": "../protocol.schema.json",
  "component": "Breadcrumb",
  "protocol": 1,
  "status": "draft",
  "summary": "面包屑。一串层级链接，用分隔符连接。",
  "anatomy": {
    "root": {
      "class": "sm-breadcrumb",
      "tag": "nav",
      "required": true,
      "aria": { "aria-label": "必填，例如「面包屑」" }
    },
    "parts": {
      "item": {
        "class": "sm-breadcrumb__item",
        "tag": "span",
        "required": true,
        "order": 1
      },
      "separator": {
        "class": "sm-breadcrumb__separator",
        "tag": "span",
        "required": false,
        "order": 2,
        "condition": "不是最后一项",
        "aria": { "aria-hidden": "true" }
      }
    }
  },
  "invariants": [
    "root 必须是 nav 且带 aria-label。",
    "最后一个 item 之后不得出现 separator。",
    "separator 必须 aria-hidden。",
    "当前页（最后一项）不得是链接。"
  ],
  "a11y": ["最后一个 item 表示当前页，不能用 link 角色。"],
  "notes": "第一个 root 使用 nav 语义的组件。"
}
